# ==============================================================================
# knowledge-server 环境配置示例
# 复制为 .env 并按需修改
# ==============================================================================

# ActionDock 服务鉴权令牌 (客户端 ad profile add sk -t <TOKEN> 使用)
ACTIONDOCK_TOKEN=your-random-secure-token-here

# 外部暴露端口 (原生 HTTPS，默认 443)
PORT=443


# 宿主机持久化根目录 (所有知识库数据子目录均基于此目录自动衍生与创建，不给自定义)
KNOWLEDGE_DATA_DIR=/data/knowledge

# 宿主机 SSH 密钥挂载目录 (用于免密操作内部 Git 仓)
SSH_DIR=/root/.ssh
